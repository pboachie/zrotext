{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zrotext.example/protocol/device-protection-origin-v1.schema.json",
  "title": "Synthetic public first-origin proof vector structure; no actor or provider authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "description",
    "parameters",
    "association",
    "core",
    "device_signature",
    "canary_signature",
    "bundle",
    "sha256"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "device_id",
        "setup_id",
        "opening_id",
        "command_id",
        "source_pairing_id",
        "attempt_id",
        "origin_digest",
        "enrolled_point",
        "enrolled_key_id",
        "canary_point",
        "opening_nonce",
        "attempt_nonce",
        "hmac_probe",
        "journal_aes_probe",
        "withdrawal_aes_probe",
        "aes_probe",
        "issued_ms",
        "expires_ms"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "setup_id": {
          "type": "string",
          "format": "uuid"
        },
        "opening_id": {
          "type": "string",
          "format": "uuid"
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_pairing_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin_digest": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "enrolled_point": {
          "type": "string",
          "minLength": 87,
          "maxLength": 87,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "enrolled_key_id": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "canary_point": {
          "type": "string",
          "minLength": 87,
          "maxLength": 87,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "opening_nonce": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "attempt_nonce": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "hmac_probe": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "journal_aes_probe": {
          "type": "string",
          "minLength": 80,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "withdrawal_aes_probe": {
          "type": "string",
          "minLength": 80,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "aes_probe": {
          "type": "string",
          "minLength": 160,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "issued_ms": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 19
        },
        "expires_ms": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 19
        }
      }
    },
    "association": {
      "type": "string",
      "minLength": 439,
      "maxLength": 439,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "core": {
      "type": "string",
      "minLength": 524,
      "maxLength": 524,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "device_signature": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "canary_signature": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "bundle": {
      "type": "string",
      "minLength": 695,
      "maxLength": 695,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "association",
        "core",
        "bundle"
      ],
      "properties": {
        "association": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "core": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "bundle": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
