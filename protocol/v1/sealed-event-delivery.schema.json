{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opaque sealed inbound event delivery",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "event_id", "delivery_id", "account_id", "device_id", "observed_at_ms", "envelope_b64", "unsigned_digest_b64"],
  "properties": {
    "v": {"const": 1},
    "type": {"const": "sealed.inbound_event"},
    "event_id": {"$ref": "#/$defs/identity"},
    "delivery_id": {"$ref": "#/$defs/identity"},
    "account_id": {"$ref": "#/$defs/identity"},
    "device_id": {"$ref": "#/$defs/identity"},
    "observed_at_ms": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "envelope_b64": {"type": "string", "minLength": 568, "maxLength": 49152, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "unsigned_digest_b64": {"type": "string", "minLength": 44, "maxLength": 44, "pattern": "^[A-Za-z0-9+/]{43}=$"}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
  }
}
