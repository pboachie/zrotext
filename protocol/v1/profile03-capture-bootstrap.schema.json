        "connection_epoch": {
          "$ref": "#/$defs/epoch"
        },
        "status_request_id": {
          "$ref": "#/$defs/uuid"
        },
        "bootstrap_id": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "enum": [
            "not_found",
            "opened",
            "accepted"
          ]
        },
        "opening": {
          "anyOf": [
            {
              "$ref": "#/$defs/opening"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_found"
              }
            }
          },
          "then": {
            "properties": {
              "opening": {
                "type": "null"
              },
              "receipt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "opened"
              }
            }
          },
          "then": {
            "properties": {
              "opening": {
                "$ref": "#/$defs/opening"
              },
              "receipt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "opening": {
                "$ref": "#/$defs/opening"
              },
              "receipt": {
                "$ref": "#/$defs/receipt"
              }
            }
          }
        }
      ]
    },
    "attempt_status_request": {
