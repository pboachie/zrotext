        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "receipt": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "attempt": {
                "$ref": "#/$defs/attempt"
              }
            }
          }
        }
      ]
    },
    "submit": {
      "type": "object",
      "required": [
        "v",
        "type",
        "connection_epoch",
        "bootstrap_id",
        "opening_id",
        "proof_request_id",
        "attempt_id",
        "attempt_nonce",
        "bundle"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "conversation_capture_bootstrap03"
        },
        "connection_epoch": {
          "$ref": "#/$defs/epoch"
        },
        "bootstrap_id": {
          "$ref": "#/$defs/uuid"
        },
        "opening_id": {
          "$ref": "#/$defs/uuid"
        },
        "proof_request_id": {
          "$ref": "#/$defs/uuid"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid"
        },
        "attempt_nonce": {
          "$ref": "#/$defs/nonce"
        },
