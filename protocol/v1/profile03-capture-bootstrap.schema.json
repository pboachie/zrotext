{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zrotext.example/protocol/profile03-capture-bootstrap.schema.json",
  "title": "Profile03 first-ever allocator association and explicit attempt recovery",
  "$comment": "Closed syntax only.473 is immutable association ONLY,521 exact attempt-bound core,649 exact two-signature packet. No473/601 signed alternate. Strict canonical bytes/lowS/signatures, actual original retained history/current enrolled actor/new-purpose hardware custody, permanent phase burns/direct closure and real commit receipt remain mandatory. No empty-table/MAX initialization or downloaded-permission inference. Outer epoch integer, historical times decimal strings; nested opening NEVER has current epoch.16NEW explicit recovery/account/device FIXED24 across connections, exact retries/status ordinary admission only; all originals/fences survive until account erasure. Commands/attempt replies4096 UTF8 bytes, original-evidence replies192KiB. This schema does not implement a counter or enable capture.",
  "oneOf": [
    {
      "$ref": "#/$defs/open_request"
    },
    {
      "$ref": "#/$defs/opened"
    },
    {
      "$ref": "#/$defs/attempt_request"
    },
    {
      "$ref": "#/$defs/attempt_reply"
    },
    {
      "$ref": "#/$defs/submit"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/opening_status_request"
    },
    {
      "$ref": "#/$defs/opening_status"
    },
    {
      "$ref": "#/$defs/attempt_status_request"
    },
    {
      "$ref": "#/$defs/attempt_status"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "decimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "association473": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{630}[AEIMQUYcgkosw048]$"
    },
    "core521": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{694}[AEIMQUYcgkosw048]$"
    },
    "bundle649": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{865}[AQgw]$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "root_pin",
        "prior_manifest02",
        "prior_accepted_ms",
        "accepted_manifest03",
        "accepted_ms",
        "bundle",
        "device_signing_point",
        "owner_approval_point",
        "registration_evidence",
        "activation_evidence"
      ],
      "properties": {
        "root_pin": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 126,
          "maxLength": 126
        },
        "prior_manifest02": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 486,
          "maxLength": 13002
        },
        "prior_accepted_ms": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "accepted_manifest03": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 488,
          "maxLength": 13004
        },
        "accepted_ms": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "bundle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 838,
          "maxLength": 838
        },
        "device_signing_point": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 87,
          "maxLength": 87
        },
        "owner_approval_point": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 87,
          "maxLength": 87
        },
        "registration_evidence": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 2,
          "maxLength": 2731
        },
        "activation_evidence": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 2,
          "maxLength": 2731
        }
      },
      "additionalProperties": false
    },
    "opening": {
      "type": "object",
      "required": [
        "bootstrap_id",
        "opening_id",
        "nonce",
        "line_id",
        "binding_id",
        "evidence",
        "created_ms"
      ],
      "properties": {
        "bootstrap_id": {
          "$ref": "#/$defs/uuid"
        },
        "opening_id": {
          "$ref": "#/$defs/uuid"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "line_id": {
          "$ref": "#/$defs/uuid"
        },
        "binding_id": {
          "$ref": "#/$defs/uuid"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "created_ms": {
          "$ref": "#/$defs/decimal"
        }
      },
      "additionalProperties": false
    },
    "predecessor": {
      "type": "object",
      "required": [
        "attempt_id",
        "core_sha256",
        "bundle_sha256"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/uuid"
        },
        "core_sha256": {
          "$ref": "#/$defs/digest"
        },
        "bundle_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": [
