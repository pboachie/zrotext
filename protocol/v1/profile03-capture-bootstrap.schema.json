        "bootstrap_id",
        "opening"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "conversation_capture_bootstrap_opened03"
        },
        "connection_epoch": {
          "$ref": "#/$defs/epoch"
        },
        "bootstrap_id": {
          "$ref": "#/$defs/uuid"
        },
        "opening": {
          "$ref": "#/$defs/opening"
        }
      },
