        "association",
        "predecessor"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "conversation_capture_bootstrap_attempt03_request"
        },
        "connection_epoch": {
          "$ref": "#/$defs/epoch"
        },
        "bootstrap_id": {
          "$ref": "#/$defs/uuid"
        },
        "opening_id": {
          "$ref": "#/$defs/uuid"
        },
        "proof_request_id": {
          "$ref": "#/$defs/uuid"
        },
        "association": {
          "$ref": "#/$defs/association473"
        },
        "predecessor": {
          "anyOf": [
            {
              "$ref": "#/$defs/predecessor"
            },
