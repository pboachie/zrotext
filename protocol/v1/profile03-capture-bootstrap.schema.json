    "opening_status_request": {
      "type": "object",
      "required": [
        "v",
        "type",
        "connection_epoch",
        "status_request_id",
        "bootstrap_id",
        "nonce"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "conversation_capture_bootstrap_status03_request"
        },
        "connection_epoch": {
          "$ref": "#/$defs/epoch"
        },
        "status_request_id": {
