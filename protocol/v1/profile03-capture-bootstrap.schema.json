        },
        "connection_epoch": {
          "$ref": "#/$defs/epoch"
        },
        "status_request_id": {
          "$ref": "#/$defs/uuid"
        },
        "bootstrap_id": {
          "$ref": "#/$defs/uuid"
        },
        "opening_id": {
          "$ref": "#/$defs/uuid"
