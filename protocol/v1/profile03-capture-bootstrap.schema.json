    "attempt_reply": {
      "type": "object",
      "required": [
        "v",
        "type",
        "connection_epoch",
        "bootstrap_id",
        "opening_id",
        "proof_request_id",
        "attempt",
        "closed_predecessor",
        "receipt"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "conversation_capture_bootstrap_attempt03"
        },
        "connection_epoch": {
          "$ref": "#/$defs/epoch"
        },
        "bootstrap_id": {
          "$ref": "#/$defs/uuid"
        },
        "opening_id": {
          "$ref": "#/$defs/uuid"
        },
        "proof_request_id": {
          "$ref": "#/$defs/uuid"
        },
        "attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/attempt"
            },
            {
              "type": "null"
            }
          ]
