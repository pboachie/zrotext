        },
        "attempt_id": {
          "$ref": "#/$defs/uuid"
        },
        "attempt_nonce": {
          "$ref": "#/$defs/nonce"
        },
        "association_sha256": {
          "$ref": "#/$defs/digest"
        },
        "core": {
          "$ref": "#/$defs/core521"
        },
        "created_ms": {
          "$ref": "#/$defs/decimal"
        }
      },
      "additionalProperties": false
    },
    "closure": {
      "type": "object",
      "required": [
        "attempt_id",
        "core_sha256",
        "bundle_sha256",
        "closed_ms",
        "superseded_by_proof_request_id",
        "superseded_by_attempt_id"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/uuid"
        },
        "core_sha256": {
          "$ref": "#/$defs/digest"
        },
        "bundle_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "closed_ms": {
          "$ref": "#/$defs/decimal"
        },
        "superseded_by_proof_request_id": {
          "$ref": "#/$defs/uuid"
        },
        "superseded_by_attempt_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "bootstrap_id",
        "opening_id",
        "proof_request_id",
        "attempt_id",
        "association_sha256",
        "core_sha256",
        "bundle_sha256",
        "device_id",
        "enrolled_signing_key_id",
        "canary_signing_key_id",
        "accepted_ms"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/uuid"
        },
        "bootstrap_id": {
          "$ref": "#/$defs/uuid"
        },
        "opening_id": {
          "$ref": "#/$defs/uuid"
        },
        "proof_request_id": {
          "$ref": "#/$defs/uuid"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid"
        },
        "association_sha256": {
          "$ref": "#/$defs/digest"
        },
        "core_sha256": {
          "$ref": "#/$defs/digest"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/digest"
        },
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "enrolled_signing_key_id": {
          "$ref": "#/$defs/digest"
        },
        "canary_signing_key_id": {
          "$ref": "#/$defs/digest"
        },
        "accepted_ms": {
          "$ref": "#/$defs/decimal"
        }
      },
      "additionalProperties": false
    },
    "open_request": {
      "type": "object",
      "required": [
        "v",
