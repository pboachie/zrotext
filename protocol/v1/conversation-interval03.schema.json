              },
              "requested_ms": {
                "$ref": "#/$defs/decimal"
              },
              "phone_signature": {
                "type": "null"
              },
              "approved_ms": {
                "type": "null"
              },
              "installed_signature": {
                "type": "null"
              },
              "installed_ms": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "install_pending"
              }
            }
          },
          "then": {
            "properties": {
              "owner_signature": {
                "$ref": "#/$defs/signature"
              },
              "requested_ms": {
                "$ref": "#/$defs/decimal"
              },
              "phone_signature": {
                "$ref": "#/$defs/signature"
              },
              "approved_ms": {
                "$ref": "#/$defs/decimal"
              },
              "installed_signature": {
                "type": "null"
              },
              "installed_ms": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "active"
              }
            }
          },
          "then": {
            "properties": {
              "owner_signature": {
                "$ref": "#/$defs/signature"
              },
              "requested_ms": {
                "$ref": "#/$defs/decimal"
              },
              "phone_signature": {
                "$ref": "#/$defs/signature"
              },
              "approved_ms": {
                "$ref": "#/$defs/decimal"
              },
              "installed_signature": {
                "$ref": "#/$defs/signature"
              },
              "installed_ms": {
                "$ref": "#/$defs/decimal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "request_kind": {
                "const": "fetch"
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "const": "active"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "owner_signature": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "requested_ms": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "requested_ms": {
                "$ref": "#/$defs/decimal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phone_signature": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "approved_ms": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "approved_ms": {
                "$ref": "#/$defs/decimal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "installed_signature": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "installed_ms": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "installed_ms": {
                "$ref": "#/$defs/decimal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phone_signature": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "owner_signature": {
                "$ref": "#/$defs/signature"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "installed_signature": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "phone_signature": {
                "$ref": "#/$defs/signature"
              }
            }
          }
        }
