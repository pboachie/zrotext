{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zrotext:profile03-conversation-interval:1",
  "title": "Additive profile03 content consent and current interval candidates",
  "$comment": "Structural grammar only. Binary signatures, clocks, original/root/current records, exact correlation, mapped registry grants and opaque local installed custody remain mandatory. This cannot opt a runtime into messaging.",
  "oneOf": [
    {
      "$ref": "#/$defs/permission"
    },
    {
      "$ref": "#/$defs/challenge"
    },
    {
      "$ref": "#/$defs/approve"
    },
    {
      "$ref": "#/$defs/install"
    },
    {
      "$ref": "#/$defs/approved"
    },
    {
      "$ref": "#/$defs/installed"
    },
    {
      "$ref": "#/$defs/status_request"
    },
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/stop"
    },
    {
      "$ref": "#/$defs/stopped"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "decimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 86,
      "maxLength": 86
    },
    "statement": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 927,
      "maxLength": 1456
    },
    "reader": {
      "type": "object",
      "required": [
        "connector_id",
        "read_grant_id",
        "key_id",
        "key_point",
        "manifest_generation",
        "read_directions",
        "registration_expires_ms",
        "grant_expires_ms",
        "key_valid_from_ms",
        "key_valid_until_ms"
      ],
      "properties": {
        "connector_id": {
          "$ref": "#/$defs/uuid"
        },
        "read_grant_id": {
          "$ref": "#/$defs/uuid"
        },
        "key_id": {
          "$ref": "#/$defs/digest"
        },
        "key_point": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 87,
          "maxLength": 87
        },
        "manifest_generation": {
          "$ref": "#/$defs/decimal"
        },
        "read_directions": {
          "const": 12
        },
        "registration_expires_ms": {
          "$ref": "#/$defs/decimal"
        },
        "grant_expires_ms": {
          "$ref": "#/$defs/decimal"
        },
        "key_valid_from_ms": {
          "$ref": "#/$defs/decimal"
        },
        "key_valid_until_ms": {
          "$ref": "#/$defs/decimal"
        }
      },
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "required": [
        "v",
        "kind",
        "request_kind",
        "request_id",
        "interval_id",
        "statement_sha256",
        "statement",
        "owner_signature",
