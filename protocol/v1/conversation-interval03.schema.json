          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/reader"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "reserved"
              }
            }
          },
          "then": {
            "properties": {
              "owner_signature": {
                "type": "null"
              },
              "requested_ms": {
                "type": "null"
              },
              "phone_signature": {
                "type": "null"
              },
              "approved_ms": {
                "type": "null"
              },
              "installed_signature": {
                "type": "null"
              },
              "installed_ms": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
