        },
        "interval_id": {
          "$ref": "#/$defs/uuid"
        },
        "statement_sha256": {
          "$ref": "#/$defs/digest"
        },
        "statement": {
          "$ref": "#/$defs/statement"
        },
        "owner_signature": {
          "oneOf": [
            {
              "$ref": "#/$defs/signature"
            },
            {
              "type": "null"
            }
          ]
        },
        "phone_signature": {
