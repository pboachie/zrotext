  "$defs": {
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "device_id",
        "source_pairing_id",
        "origin_digest",
        "enrolled_point",
        "enrolled_key_id",
        "opening_nonce",
        "created_ms",
        "pairing_created_ms",
        "pairing_claimed_ms",
        "pairing_approved_ms",
        "pairing_expires_ms"
      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/uuid"
        },
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_pairing_id": {
          "$ref": "#/$defs/uuid"
        },
        "origin_digest": {
          "$ref": "#/$defs/digest"
        },
        "enrolled_point": {
          "type": "string",
          "minLength": 87,
          "maxLength": 87,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "enrolled_key_id": {
          "$ref": "#/$defs/digest"
        },
        "opening_nonce": {
          "$ref": "#/$defs/digest"
        },
        "created_ms": {
          "$ref": "#/$defs/decimal"
        },
        "pairing_created_ms": {
          "$ref": "#/$defs/decimal"
        },
        "pairing_claimed_ms": {
          "$ref": "#/$defs/decimal"
        },
        "pairing_approved_ms": {
          "$ref": "#/$defs/decimal"
        },
        "pairing_expires_ms": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_request_id",
        "attempt_id",
        "core",
        "nonce",
        "closed_predecessor"
      ],
      "properties": {
        "proof_request_id": {
          "$ref": "#/$defs/uuid"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid"
        },
        "core": {
          "type": "string",
          "minLength": 524,
          "maxLength": 524,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "nonce": {
          "$ref": "#/$defs/digest"
        },
        "closed_predecessor": {
          "anyOf": [
            {
              "$ref": "#/$defs/closed_predecessor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "association_sha256",
        "core_sha256",
        "bundle_sha256",
        "accepted_ms"
      ],
      "properties": {
        "association_sha256": {
          "$ref": "#/$defs/digest"
        },
        "core_sha256": {
          "$ref": "#/$defs/digest"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/digest"
        },
        "accepted_ms": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "closed_predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_request_id",
        "attempt_id",
        "core_sha256",
        "bundle_sha256",
        "closed_ms"
      ],
      "properties": {
        "proof_request_id": {
          "$ref": "#/$defs/uuid"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid"
        },
        "core_sha256": {
          "$ref": "#/$defs/digest"
        },
        "bundle_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "closed_ms": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "digest": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  }
}
