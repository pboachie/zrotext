{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zrotext.example/protocol/v1/conversation-effects03-vector.schema.json",
  "title": "Synthetic typed conversation effect byte fixtures",
  "description": "Structural fixture grammar only. No current actor, durable closure, accepted effect or invocation permission follows from schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "description", "enrolled_point", "enrolled_key_id", "cases"],
  "properties": {
    "v": {"const": 1},
    "description": {"type": "string"},
    "enrolled_point": {"$ref": "#/$defs/point"},
    "enrolled_key_id": {"$ref": "#/$defs/hash"},
    "cases": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "decimal": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "hash": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "point": {"type": "string", "pattern": "^[A-Za-z0-9_-]{87}$"},
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "evidence", "segment_index", "observed_ms", "command", "commitment"],
      "properties": {
        "event_id": {"$ref": "#/$defs/uuid"},
        "evidence": {"type": "integer", "minimum": 0, "maximum": 5},
        "segment_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
        "observed_ms": {"$ref": "#/$defs/decimal"},
        "command": {"type": "string", "pattern": "^[A-Za-z0-9_-]{282}$"},
        "commitment": {"$ref": "#/$defs/hash"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["ids", "numbers", "closed_from", "nonce", "digests", "submit", "submit_commitment", "closure_record", "closure_commitment", "core", "core_sha256", "signature", "outcomes"],
      "properties": {
        "ids": {
          "type": "object", "additionalProperties": false,
          "required": ["account_id", "device_id", "event_id", "message_id", "attempt_id", "closure_id", "proof_request_id", "challenge_id"],
          "properties": {
            "account_id": {"$ref": "#/$defs/uuid"},
            "device_id": {"$ref": "#/$defs/uuid"},
            "event_id": {"$ref": "#/$defs/uuid"},
            "message_id": {"$ref": "#/$defs/uuid"},
            "attempt_id": {"$ref": "#/$defs/uuid"},
            "closure_id": {"$ref": "#/$defs/uuid"},
            "proof_request_id": {"$ref": "#/$defs/uuid"},
            "challenge_id": {"$ref": "#/$defs/uuid"}
          }
        },
        "numbers": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/decimal"}},
        "closed_from": {"enum": [0, 1]},
        "nonce": {"$ref": "#/$defs/hash"},
        "digests": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/hash"}},
        "submit": {"type": "string", "pattern": "^[A-Za-z0-9_-]{204}$"},
        "submit_commitment": {"$ref": "#/$defs/hash"},
        "closure_record": {"type": "string", "pattern": "^[A-Za-z0-9_-]{280}$"},
        "closure_commitment": {"$ref": "#/$defs/hash"},
        "core": {"type": "string", "pattern": "^[A-Za-z0-9_-]{588}$"},
        "core_sha256": {"$ref": "#/$defs/hash"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
        "outcomes": {"type": "array", "minItems": 6, "maxItems": 16, "items": {"$ref": "#/$defs/outcome"}}
      }
    }
  }
}
