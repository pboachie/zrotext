{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dormant provider SMS submit body codec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "from",
    "messaging_profile_id",
    "to",
    "text",
    "type",
    "encoding"
  ],
  "properties": {
    "from": {
      "type": "string",
      "pattern": "^[+][1-9][0-9]{1,14}$(?![\n\r\u2028\u2029])"
    },
    "messaging_profile_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\n\r\u2028\u2029])",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "minLength": 36,
      "maxLength": 36
    },
    "to": {
      "type": "string",
      "pattern": "^[+][1-9][0-9]{1,14}$(?![\n\r\u2028\u2029])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[\u0000-\ud7ff\ue000-\uffff]+$(?![\n\r\u2028\u2029])"
    },
    "type": {
      "const": "SMS"
    },
    "encoding": {
      "const": "ucs2"
    }
  }
}
