{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-configured customer routine policy candidate",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "context_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "routine_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "faq",
        "intake",
        "note",
        "reminder",
        "owner_reply"
      ]
    },
    "executor": {
      "enum": [
        "deterministic_local",
        "local_process"
      ]
    },
    "adapter_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "artifact_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "period": {
      "const": "utc_day"
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "call_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "unit_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "units_per_call": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "turn_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 10,
      "maximum": 30000
    },
    "window": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "first_local_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "opens_minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "closes_minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "repeat_every_days": {
          "type": "null"
        },
        "max_occurrences": {
          "const": 1
        },
        "pacing_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        }
      },
      "required": [
        "timezone",
        "first_local_date",
        "opens_minute",
        "closes_minute",
        "repeat_every_days",
        "max_occurrences",
        "pacing_seconds"
      ],
      "additionalProperties": false
    },
    "original_input": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "grant_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "grant_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "request_id",
    "policy_id",
    "context_id",
    "routine_id",
    "generation",
    "kind",
    "executor",
    "period",
    "expires_ms",
    "call_limit",
    "unit_limit",
    "units_per_call",
    "turn_limit",
    "timeout_ms",
    "window"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "executor": {
            "const": "local_process"
          }
        }
      },
      "then": {
        "required": [
          "adapter_id",
          "artifact_digest"
        ],
        "properties": {
          "adapter_id": {
            "type": "string"
          },
          "artifact_digest": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "adapter_id": {
            "type": "null"
          },
          "artifact_digest": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "original_input"
        ],
        "properties": {
          "original_input": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "executor": {
            "const": "local_process"
          }
        }
      }
    }
  ]
}
