{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zrotext.com/protocol/v1/device-stream.schema.json",
  "title": "ZROtext device stream v1 frames",
  "description": "Tagged JSON frames on /v1/device-stream. The authenticated socket supplies account and device identity for events.",
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/proof"},
    {"$ref": "#/$defs/heartbeat"},
    {"$ref": "#/$defs/alpha_ready"},
    {"$ref": "#/$defs/radio_event"},
    {"$ref": "#/$defs/inbound_event"},
    {"$ref": "#/$defs/challenge"},
    {"$ref": "#/$defs/session"},
    {"$ref": "#/$defs/heartbeat_ack"},
    {"$ref": "#/$defs/synthetic_grant"},
    {"$ref": "#/$defs/radio_event_ack"},
    {"$ref": "#/$defs/inbound_event_ack"}
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "epoch": {"type": "integer", "minimum": 1},
    "ms": {"type": "integer", "minimum": 0},
    "digest": {"type": "string", "description": "Base64url without padding of SHA-256 of the exact E.164 recipient bytes."},
    "hello": {"type": "object", "additionalProperties": false, "required": ["type", "v", "device_id"], "properties": {"type": {"const": "hello"}, "v": {"const": 1}, "device_id": {"$ref": "#/$defs/uuid"}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["type", "v", "challenge_id", "account_id", "device_id", "nonce", "signature_der"], "properties": {"type": {"const": "proof"}, "v": {"const": 1}, "challenge_id": {"$ref": "#/$defs/uuid"}, "account_id": {"$ref": "#/$defs/uuid"}, "device_id": {"$ref": "#/$defs/uuid"}, "nonce": {"type": "string"}, "signature_der": {"type": "string"}}},
    "heartbeat": {"type": "object", "additionalProperties": false, "required": ["type", "v"], "properties": {"type": {"const": "heartbeat"}, "v": {"const": 1}}},
    "alpha_ready": {"type": "object", "additionalProperties": false, "required": ["type", "v", "connection_epoch", "recipient_digest"], "properties": {"type": {"const": "alpha_ready"}, "v": {"const": 1}, "connection_epoch": {"$ref": "#/$defs/epoch"}, "recipient_digest": {"$ref": "#/$defs/digest"}}},
    "radio_event": {"type": "object", "additionalProperties": false, "required": ["type", "v", "connection_epoch", "event_id", "message_id", "attempt_id", "evidence", "observed_at_ms"], "properties": {"type": {"const": "radio_event"}, "v": {"const": 1}, "connection_epoch": {"$ref": "#/$defs/epoch"}, "event_id": {"$ref": "#/$defs/uuid"}, "message_id": {"$ref": "#/$defs/uuid"}, "attempt_id": {"$ref": "#/$defs/uuid"}, "evidence": {"enum": ["durable_submit_intent", "proven_no_submit", "sent_callback_ok", "sent_callback_failed", "delivery_callback_ok", "delivery_timeout", "crash_without_callback", "callback_conflict"]}, "observed_at_ms": {"$ref": "#/$defs/ms"}, "segment_index": {"type": ["integer", "null"], "minimum": 0}, "segment_count": {"type": ["integer", "null"], "minimum": 1, "maximum": 6}}},
    "inbound_event": {"type": "object", "additionalProperties": false, "required": ["type", "v", "connection_epoch", "event_id", "sequence", "message_id", "attempt_id", "classification", "observed_at_ms", "part_count", "signature_der"], "properties": {"type": {"const": "inbound_event"}, "v": {"const": 1}, "connection_epoch": {"$ref": "#/$defs/epoch"}, "event_id": {"$ref": "#/$defs/uuid"}, "sequence": {"type": "integer", "minimum": 1}, "message_id": {"$ref": "#/$defs/uuid"}, "attempt_id": {"$ref": "#/$defs/uuid"}, "classification": {"enum": ["captured_local", "sim_unverified", "send_unverified", "encryption_unverified", "opt_out", "opt_out_review", "opt_in"]}, "observed_at_ms": {"$ref": "#/$defs/ms"}, "part_count": {"type": "integer", "minimum": 1}, "signature_der": {"type": "string"}}},
    "challenge": {"type": "object", "additionalProperties": false, "required": ["type", "v", "challenge_id", "account_id", "device_id", "nonce"], "properties": {"type": {"const": "challenge"}, "v": {"const": 1}, "challenge_id": {"$ref": "#/$defs/uuid"}, "account_id": {"$ref": "#/$defs/uuid"}, "device_id": {"$ref": "#/$defs/uuid"}, "nonce": {"type": "string"}}},
    "session": {"type": "object", "additionalProperties": false, "required": ["type", "v", "connection_epoch", "heartbeat_seconds"], "properties": {"type": {"const": "session"}, "v": {"const": 1}, "connection_epoch": {"$ref": "#/$defs/epoch"}, "heartbeat_seconds": {"type": "integer", "minimum": 1}}},
    "heartbeat_ack": {"type": "object", "additionalProperties": false, "required": ["type", "v", "connection_epoch"], "properties": {"type": {"const": "heartbeat_ack"}, "v": {"const": 1}, "connection_epoch": {"$ref": "#/$defs/epoch"}}},
    "synthetic_grant": {"type": "object", "additionalProperties": false, "required": ["type", "v", "message_id", "attempt_id", "device_id", "generation", "connection_epoch", "deployment_epoch", "recipient_digest", "expires_at_ms", "recipient_e164", "body"], "properties": {"type": {"const": "synthetic_grant"}, "v": {"const": 1}, "message_id": {"$ref": "#/$defs/uuid"}, "attempt_id": {"$ref": "#/$defs/uuid"}, "device_id": {"$ref": "#/$defs/uuid"}, "generation": {"type": "integer", "minimum": 1}, "connection_epoch": {"$ref": "#/$defs/epoch"}, "deployment_epoch": {"$ref": "#/$defs/epoch"}, "recipient_digest": {"$ref": "#/$defs/digest"}, "expires_at_ms": {"$ref": "#/$defs/ms"}, "recipient_e164": {"type": "string", "description": "Plaintext E.164 recipient number; this grant discloses it to the device."}, "body": {"type": "string", "description": "Plaintext fixed synthetic test message."}}},
    "radio_event_ack": {"type": "object", "additionalProperties": false, "required": ["type", "v", "event_id", "state", "submit_permitted"], "properties": {"type": {"const": "radio_event_ack"}, "v": {"const": 1}, "event_id": {"$ref": "#/$defs/uuid"}, "state": {"enum": ["accepted", "queued", "claimed", "submitting", "submitted", "delivered", "delivery_unknown", "unknown", "failed", "cancelled", "expired"]}, "submit_permitted": {"type": "boolean"}}},
    "inbound_event_ack": {"type": "object", "additionalProperties": false, "required": ["type", "v", "event_id", "created", "queued_deliveries"], "properties": {"type": {"const": "inbound_event_ack"}, "v": {"const": 1}, "event_id": {"$ref": "#/$defs/uuid"}, "created": {"type": "boolean"}, "queued_deliveries": {"type": "integer", "minimum": 0}, "suppression_cleared": {"type": "boolean"}}}
  }
}
