{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zrotext.example/protocol/external-authority-v1",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "fence"
                },
                "site": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "epoch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                }
              },
              "required": [
                "kind",
                "site",
                "epoch"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "status"
                },
                "site": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              },
              "required": [
                "kind",
                "site"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "read_epoch"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "record_epoch"
                },
                "epoch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                }
              },
              "required": [
                "kind",
                "epoch"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "namespace",
        "nonce",
        "operation"
      ],
      "additionalProperties": false
    },
    "reply": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "fenced"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "kind",
            "epoch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "already_fenced"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "kind",
            "epoch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "competing_fence"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "kind",
            "epoch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "epoch"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "kind",
            "epoch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "recorded"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "kind",
            "epoch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "refused_epoch"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "kind",
            "epoch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unfenced"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unconfirmed"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "signature": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "required": [
    "request",
    "reply",
    "signature"
  ],
  "additionalProperties": false
}
