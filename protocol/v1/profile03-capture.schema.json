      ]
    },
    "permission": {
      "type": "object",
      "required": [
        "v",
        "kind",
        "request_kind",
        "request_id",
        "interval_id",
        "statement_sha256",
        "statement",
        "owner_signature",
        "phone_signature",
        "installed_signature",
        "requested_ms",
        "approved_ms",
        "installed_ms",
        "phase",
        "device_session_digest",
        "physical_selection_digest",
        "owner_session_digest",
        "compared_ms",
        "permission_expires_ms",
