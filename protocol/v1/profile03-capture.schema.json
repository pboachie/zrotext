{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zrotext.example/protocol/profile03-capture.schema.json",
  "title": "Additive profile03 capture transport",
  "$comment": "Closed syntax only, not permission. Exact current-source correlation, strict canonical bytes and signed i64 range, installed original113 proofs/custody/manifest ancestry/physical lease, first-receipt clock interval, one-use durable sequence/signing phases and commit ACK remain mandatory. Outer socket epoch is a JSON integer; projection counters/times are canonical decimal strings. Request/status <=4096 UTF8 bytes, upload <=48000, reply <=192KiB. Old grammars unchanged.",
  "oneOf": [
    {
      "$ref": "#/$defs/permission_request"
    },
    {
      "$ref": "#/$defs/permission_reply"
    },
    {
      "$ref": "#/$defs/upload"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/status_request"
    },
    {
      "$ref": "#/$defs/status"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "decimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 86,
      "maxLength": 86
    },
    "statement": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 927,
      "maxLength": 1456
    },
    "reader": {
      "type": "object",
      "required": [
        "connector_id",
        "read_grant_id",
        "key_id",
        "key_point",
        "manifest_generation",
        "read_directions",
        "registration_expires_ms",
        "grant_expires_ms",
        "key_valid_from_ms",
        "key_valid_until_ms"
      ],
      "properties": {
        "connector_id": {
          "$ref": "#/$defs/uuid"
        },
        "read_grant_id": {
          "$ref": "#/$defs/uuid"
        },
        "key_id": {
          "$ref": "#/$defs/digest"
        },
        "key_point": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 87,
          "maxLength": 87
        },
        "manifest_generation": {
          "$ref": "#/$defs/decimal"
        },
        "read_directions": {
          "const": 12
        },
        "registration_expires_ms": {
          "$ref": "#/$defs/decimal"
        },
        "grant_expires_ms": {
          "$ref": "#/$defs/decimal"
        },
        "key_valid_from_ms": {
          "$ref": "#/$defs/decimal"
        },
        "key_valid_until_ms": {
          "$ref": "#/$defs/decimal"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "root_pin",
        "prior_manifest02",
        "prior_accepted_ms",
        "accepted_manifest03",
        "accepted_ms",
        "bundle",
        "device_signing_point",
        "owner_approval_point",
        "registration_evidence",
        "activation_evidence"
      ],
      "properties": {
        "root_pin": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 126,
          "maxLength": 126
        },
        "prior_manifest02": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 486,
          "maxLength": 13002
        },
        "prior_accepted_ms": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "accepted_manifest03": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 488,
          "maxLength": 13004
        },
        "accepted_ms": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "bundle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 838,
          "maxLength": 838
        },
        "device_signing_point": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 87,
          "maxLength": 87
        },
        "owner_approval_point": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 87,
          "maxLength": 87
        },
        "registration_evidence": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 2,
          "maxLength": 2731
        },
        "activation_evidence": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 2,
          "maxLength": 2731
        }
      },
      "additionalProperties": false
    },
    "physical": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
