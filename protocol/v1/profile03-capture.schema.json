      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "interval_permission03"
        },
        "request_kind": {
          "const": "capture"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "interval_id": {
          "$ref": "#/$defs/uuid"
        },
        "statement_sha256": {
