          "const": 2
        },
        "type": {
          "const": "sealed_line_proof_ack_v2"
        },
        "challenge_id": {
          "$ref": "#/$defs/uuid"
        },
        "accepted": {
          "type": "boolean"
        },
        "connection_epoch": {
          "$ref": "#/$defs/positive_i64_string"
        }
      }
    },
    "sealed_line_activated_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
