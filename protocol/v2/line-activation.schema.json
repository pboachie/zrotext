        "type": {
          "const": "sealed_line_proof_v2"
        },
        "challenge_id": {
          "$ref": "#/$defs/uuid"
        },
        "connection_epoch": {
          "$ref": "#/$defs/positive_i64_string"
        },
        "observation_b64url": {
          "$ref": "#/$defs/observation"
        },
        "signature_der": {
          "$ref": "#/$defs/der"
        }
