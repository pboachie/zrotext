{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Additive complete selected-line v2 exchange frames",
  "description": "Draft contract. Raw JSON must reject duplicate keys, floating-point numeric tokens and frames over 4096 UTF-8 bytes before schema validation. Cryptographic and authenticated runtime admission are separate.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$(?![\\s]|[\\S]))[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s]|[\\S])"
    },
    "positive_i64_string": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|[9][0-1][0-9]{17}|[9][2][0-1][0-9]{16}|[9][2][2][0-2][0-9]{15}|[9][2][2][3][0-2][0-9]{14}|[9][2][2][3][3][0-6][0-9]{13}|[9][2][2][3][3][7][0-1][0-9]{12}|[9][2][2][3][3][7][2][0][0-2][0-9]{10}|[9][2][2][3][3][7][2][0][3][0-5][0-9]{9}|[9][2][2][3][3][7][2][0][3][6][0-7][0-9]{8}|[9][2][2][3][3][7][2][0][3][6][8][0-4][0-9]{7}|[9][2][2][3][3][7][2][0][3][6][8][5][0-3][0-9]{6}|[9][2][2][3][3][7][2][0][3][6][8][5][4][0-6][0-9]{5}|[9][2][2][3][3][7][2][0][3][6][8][5][4][7][0-6][0-9]{4}|[9][2][2][3][3][7][2][0][3][6][8][5][4][7][7][0-4][0-9]{3}|[9][2][2][3][3][7][2][0][3][6][8][5][4][7][7][5][0-7][0-9]{2}|[9][2][2][3][3][7][2][0][3][6][8][5][4][7][7][5][8][0][0-6]|9223372036854775807)$(?![\\s]|[\\S])"
    },
    "ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "digest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s]|[\\S])"
    },
    "observation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{161}[AQgw]$(?![\\s]|[\\S])"
    },
    "der": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11,107}$(?![\\s]|[\\S])",
      "description": "Lexical bound only. Consumers must decode canonical unpadded base64url and canonical nonzero P-256 ECDSA DER; 8..80 decoded bytes."
    },
    "sms_line_challenge_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "account_id",
        "line_id",
        "device_id",
        "challenge_id",
        "generation",
        "nonce",
        "expires_at_ms"
      ],
      "properties": {
        "v": {
          "const": 2
        },
        "type": {
          "const": "sms_line_challenge_v2"
        },
        "account_id": {
          "$ref": "#/$defs/uuid"
        },
        "line_id": {
          "$ref": "#/$defs/uuid"
        },
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "challenge_id": {
          "$ref": "#/$defs/uuid"
        },
        "generation": {
          "$ref": "#/$defs/positive_i64_string"
        },
        "nonce": {
          "$ref": "#/$defs/digest"
        },
        "expires_at_ms": {
          "$ref": "#/$defs/ms"
        }
      }
    },
    "sms_line_proof_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "challenge_id",
        "connection_epoch",
        "observation_b64url",
        "signature_der"
      ],
      "properties": {
        "v": {
          "const": 2
        },
        "type": {
          "const": "sms_line_proof_v2"
        },
        "challenge_id": {
          "$ref": "#/$defs/uuid"
        },
        "connection_epoch": {
          "$ref": "#/$defs/positive_i64_string"
        },
        "observation_b64url": {
          "$ref": "#/$defs/observation"
        },
        "signature_der": {
          "$ref": "#/$defs/der"
        }
      }
    },
    "sms_line_proof_ack_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "challenge_id",
        "accepted"
      ],
      "properties": {
        "v": {
          "const": 2
        },
        "type": {
          "const": "sms_line_proof_ack_v2"
        },
        "challenge_id": {
          "$ref": "#/$defs/uuid"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "sms_line_activated_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "account_id",
        "line_id",
        "device_id",
        "challenge_id",
        "generation",
        "device_statement_sha256",
        "device_signature_sha256"
      ],
      "properties": {
        "v": {
          "const": 2
        },
        "type": {
          "const": "sms_line_activated_v2"
        },
        "account_id": {
          "$ref": "#/$defs/uuid"
        },
        "line_id": {
          "$ref": "#/$defs/uuid"
        },
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "challenge_id": {
          "$ref": "#/$defs/uuid"
        },
        "generation": {
          "$ref": "#/$defs/positive_i64_string"
        },
        "device_statement_sha256": {
          "$ref": "#/$defs/digest"
        },
        "device_signature_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "sealed_line_challenge_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
