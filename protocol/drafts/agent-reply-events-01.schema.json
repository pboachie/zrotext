{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unapproved customer-local reply adapter response candidate",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/action" },
    { "$ref": "#/$defs/ingest" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "number": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "content": {
      "oneOf": [
        { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["metadata_stop", "unavailable"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "text", "readerId"], "properties": {
          "kind": { "const": "decrypted" }, "text": { "type": "string", "minLength": 1, "maxLength": 32768, "pattern": "^[^\ufeff\u0000][^\u0000]*$" },
          "readerId": { "$ref": "#/$defs/id" }
        }, "additionalProperties": false }
      ]
    },
    "event": {
      "type": "object",
      "required": ["sequence", "account_id", "line_id", "device_id", "event_id", "message_id", "attempt_id", "classification", "observed_at_ms", "content", "consumed", "approval"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "account_id": { "$ref": "#/$defs/id" }, "line_id": { "$ref": "#/$defs/id" },
        "device_id": { "$ref": "#/$defs/id" }, "event_id": { "$ref": "#/$defs/id" },
        "message_id": { "$ref": "#/$defs/id" }, "attempt_id": { "$ref": "#/$defs/id" },
        "classification": { "enum": ["captured_local", "sim_unverified", "send_unverified", "encryption_unverified", "opt_out", "opt_out_review", "opt_in"] },
        "observed_at_ms": { "$ref": "#/$defs/number" }, "content": { "$ref": "#/$defs/content" },
        "consumed": { "type": "boolean" }, "approval": { "const": false }
      },
      "allOf": [{
        "if": { "properties": { "classification": { "enum": ["opt_out", "opt_out_review"] } } },
        "then": { "properties": { "content": { "properties": { "kind": { "const": "metadata_stop" } } } } },
        "else": { "properties": { "content": { "properties": { "kind": { "enum": ["decrypted", "unavailable"] } } } } }
      }],
      "additionalProperties": false
    },
    "page": {
      "type": "object", "required": ["events", "cursor"],
      "properties": {
        "events": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/event" } },
        "cursor": { "type": "string", "maxLength": 1024, "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$" }
      }, "additionalProperties": false
    },
    "action": {
      "type": "object", "required": ["actionId", "disposition", "execute", "state", "approval"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" }, "disposition": { "enum": ["reply_notice", "owner_review", "stop"] },
        "execute": { "type": "boolean" }, "state": { "enum": ["reserved", "completed", "unknown"] },
        "approval": { "const": false }
      }, "allOf": [{ "if": { "properties": { "state": { "const": "unknown" } } }, "then": { "properties": { "execute": { "const": false } } } }], "additionalProperties": false
    },
    "ingest": {
      "type": "object", "required": ["created", "sequence"],
      "properties": { "created": { "type": "boolean" }, "sequence": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    },
    "error": {
      "type": "object", "required": ["code"],
      "properties": { "code": { "enum": ["invalid_request", "invalid_event", "invalid_signature", "foreign_scope", "expired", "revoked", "retention_full", "unavailable", "invalid_cursor", "cursor_expired", "identity_conflict", "out_of_order", "unauthorized"] } },
      "additionalProperties": false
    }
  }
}
