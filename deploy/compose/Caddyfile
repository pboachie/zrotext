{$EDGE_DOMAIN} {
	# Compress responses at the edge so a dashboard load transfers ~21 KB
	# instead of ~93 KB. The streaming endpoints are excluded so the
	# live-update SSE stream and the long-lived device WebSockets are never
	# buffered. (Caddy 2.11 header matchers cannot negate a field value, so
	# the exclusion is by path, which covers exactly those two streams.)
	@compressible not path /owner/events /v1/device-stream
	encode @compressible zstd gzip
	reverse_proxy app:8080 {
		# Authenticated device streams are long-lived WebSockets. Caddy
		# forwards the Upgrade and Host headers without extra directives.
		stream_timeout 24h
		stream_close_delay 5m
	}
}
