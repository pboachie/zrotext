{$EDGE_DOMAIN} {
	# Compress the embedded owner assets at the edge so a dashboard load
	# transfers ~21 KB instead of ~93 KB. text/event-stream is excluded so
	# the live-update stream is never buffered.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header !Content-Type text/event-stream
		}
	}
	reverse_proxy app:8080 {
		# Authenticated device streams are long-lived WebSockets. Caddy
		# forwards the Upgrade and Host headers without extra directives.
		stream_timeout 24h
		stream_close_delay 5m
	}
}
