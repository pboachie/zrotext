# Local self-host example only. Replace before exposing any service.
# Separate public account root review page; local history only, default off.
ACCOUNT_ROOT_TRUST_ENABLED=false
# Explicit external package made by scripts/package_account_root_trust_browser.mjs.
# ACCOUNT_ROOT_TRUST_SDK_DIRECTORY=/path/to/public-account-trust-sdk
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
DATABASE_URL=postgres://zrotext:replace-with-a-long-random-local-secret@db:5432/zrotext?sslmode=disable
# For a remote database, set sslmode=require in every server/migrator/rewrap URL.
# Accepted sslmode values: require, prefer, disable; verify-full and verify-ca
# mean require. Every TLS connection verifies the certificate chain and that its
# hostname matches the URL host; set a private CA PEM if needed.
# DATABASE_TLS_CA_PEM_B64=base64-encoded-PEM-CA-bundle
# Plaintext (sslmode=prefer/disable) is allowed without this only to loopback or
# a Unix socket. The bundled Compose db has no TLS, so this example opts in and
# each process logs a plaintext warning at startup.
DATABASE_ALLOW_PLAINTEXT=true
# Generate 32 random bytes as 64 hexadecimal characters for the runtime credential.
# Compose builds the restricted runtime URL; DATABASE_URL above is migration-only.
RUNTIME_DATABASE_PASSWORD=replace-with-a-secret
SITE_ID=local-a
INSTANCE_ID=api-1
# Compose pins dispatch off; this key applies when running a local binary.
DISPATCH_ENABLED=false
DEPLOYMENT_EPOCH=1
# Bounded retention windows in days (1..3650); see docs/SELF-HOSTING.md.
ZT_IDEMPOTENCY_RETENTION_DAYS=7
ZT_MESSAGE_CONTENT_RETENTION_DAYS=30
ZT_MESSAGE_EVENTS_RETENTION_DAYS=90
ZT_WEBHOOK_HISTORY_RETENTION_DAYS=30
ZT_INBOUND_CONTENT_RETENTION_DAYS=30
ZT_SEALED_INBOUND_CONTENT_RETENTION_DAYS=30
# Optional local host port for the API; defaults to 8080.
APP_PORT=8080
# Optional server bind address. In Compose, retain port 8080 inside the
# container; the host-side published port stays loopback-only.
# BIND_ADDR=0.0.0.0:8080
# The migrator uses /opt/zrotext/migrations in Compose; override for a local binary.
# MIGRATIONS_DIR=deploy/compose/migrations
# If this deployment modifies the server, point to its full corresponding
# source. Without this setting, release builds link to their upstream commit.
# SOURCE_URL=https://example.com/your-fork/source
# Controlled synthetic test mode only; account/recipient allowlists are private
# runtime configuration and must both be nonempty before this can be enabled.
SYNTHETIC_ALPHA_ENABLED=false
# Private pilot allowlists; required and nonempty if the synthetic mode is enabled.
# SYNTHETIC_ALPHA_ALLOWED_ACCOUNT_IDS=<comma-separated account UUIDs>
# SYNTHETIC_ALPHA_ALLOWED_RECIPIENTS=<comma-separated E.164 numbers>
# Founder gating for the outbound MMS spike (#438): default-off. When true,
# MMS_SPIKE_GRANT_DEVICE names the one gateway device and
# MMS_SPIKE_GRANT_RECIPIENTS the controlled recipient allowlist.
MMS_SPIKE_GRANT_ENABLED=false
# MMS_SPIKE_GRANT_DEVICE=<device UUID>
# MMS_SPIKE_GRANT_RECIPIENTS=<comma-separated E.164 numbers>
# Inbound metadata pilot is off by default.
# INBOUND_PILOT_ENABLED=false
# Signed attempt-free line-bound opt-out receiver; requires approved line
# activation and enrolled phone proof. Disabled until those are provisioned.
# LINE_OPT_OUT_ENABLED=false
# Owner-approved SMS line activation routes and device-stream frames. Owners
# still need an external signer for approval; keep disabled until reviewed.
# SMS_LINE_ACTIVATION_ENABLED=false
# Selected own-ciphertext draft collaboration routes. No decryption, approval,
# sending, team management or root authority; off until separately enabled.
# COLLABORATION_DRAFTS_ENABLED=false
# Sealed v1 message admission route (/v1/sealed/messages). Disabled by
# default; off leaves the route unmounted. Enabling requires a provisioned
# sealed manifest authority per account; unprovisioned accounts fail closed.
# SEALED_ADMISSION_ENABLED=false
# SEALED_DISPATCH_ENABLED=false
# Shared integration tools HTTP transport. Dedicated workflow grants only;
# send prepares an existing owner-bound message and never grants radio authority.
# WORKFLOW_TOOLS_ENABLED=false
# CUSTOMER_ROUTINES_ENABLED=false
# Mount owner grant metadata routes only; production issuance remains unavailable.
# This does not install schema, admit a reader/policy, or enable a provider.
MANAGED_AI_GRANTS_ENABLED=false
# Owner-only synthetic exposure preflight/status and pre-intent cleanup.
# Requires existing exact approved actions and operator-installed TEST budgets.
# No execution intent, settlement, transport or payment is exposed by this gate.
# EXPOSURE_TEST_ENABLED=false
# Independent-quorum automatic failover module. Disabled by default; enabling
# validates the three-member quorum configuration and runs the decision
# executor against the writer database (site fence via sites.draining, the
# deployment_authority epoch bump with the promoted site enabled and dispatch
# forced paused). Members are failure-domain identifiers, one per workload
# location plus a lightweight third member. FAILOVER_QUORUM_STORE_DIR is the
# durable consensus store directory (an absolute path without . or .. segments;
# membership record plus append-only per-member observation journals, one
# directory per app instance); the member-side reporting loop records this
# instance's rounds into it, but no production probe source exists yet — its
# without adapter configuration rounds abstain; see docs/MULTI-LOCATION.md.
# FAILOVER_QUORUM_ENABLED=false
# FAILOVER_QUORUM_MEMBERS=workload-a,workload-b,witness
# FAILOVER_QUORUM_WRITER_SITE_ID=site-a
# FAILOVER_QUORUM_STANDBY_SITE_ID=site-b
# FAILOVER_QUORUM_CHECK_INTERVAL_MS=5000
# FAILOVER_QUORUM_STORE_DIR=/var/lib/zrotext/failover-store
# Reporting loop, read only when enabled. FAILOVER_QUORUM_REPORT_MEMBER_ID
# must be one of FAILOVER_QUORUM_MEMBERS (the identity this instance reports
# as); FAILOVER_QUORUM_PROBE_INTERVAL_MS defaults to the check interval.
# FAILOVER_QUORUM_PROBE_INTERVAL_MS=5000
# FAILOVER_QUORUM_PROBE_TIMEOUT_MS=1500
# FAILOVER_QUORUM_REPORT_MEMBER_ID=witness
# Optional private adapter configuration file; empty keeps reporting abstaining.
# Contains HTTPS endpoints and secret-file references; never commit real configuration.
# FAILOVER_QUORUM_ADAPTER_CONFIG=
# Independent customer authority configuration; absent refuses host fencing.
# FAILOVER_EXTERNAL_AUTHORITY_CONFIG=
# Emit device-stream diagnostics during local troubleshooting only.
# ZT_DEVICE_STREAM_DIAGNOSTIC=1
# Optional M0 test socket only. Set a random 32+ character value privately.
M0_TEST_TOKEN=
# Optional until owner MFA is enabled. Use an independently generated 32-byte
# base64 key; retain it across sites and backups to keep TOTP factors usable.
MFA_ENCRYPTION_KEY_B64=
# Keep enrollment off until every account-serving instance has the same key
# and all older binaries have been drained.
MFA_ENROLLMENT_ENABLED=false
# Expose authenticated root challenge/enrollment/export only with configured
# account routes and the matching MFA encryption key; recovery-only is incompatible.
# This does not create owner keys, enroll readers, or authorize SMS.
ROOT_CUSTODY_ENABLED=false
# Operator recovery mode ignores the TOTP key and permits one-use recovery
# codes with the owner's password. Use only for a lost/unavailable key.
MFA_RECOVERY_ONLY=false
# Account routes are unmounted unless all three are supplied. Generate two
# independent peppers privately and keep them stable across sites/restores.
# AUTH_ORIGIN=https://app.example.test
# Use the browser's exact HTTPS Origin serialization: lowercase ASCII/punycode
# host, omit the default :443 port, and include no trailing slash or path.
# AUTH_TOKEN_PEPPER_B64=<base64 of random 32+ bytes>
# ENROLLMENT_TOKEN_PEPPER_B64=<base64 of different random 32+ bytes>
# SMTP alone never opens public sign-up. Registration defaults to closed.
# Create the first verified owner with the local zrotext-admin CLI while all
# API instances are stopped; no HTTP registration or verification mail is used.
# REGISTRATION_MODE=closed
# REGISTRATION_MODE=allowlist
# REGISTRATION_ALLOWED_EMAILS=owner@example.test
# REGISTRATION_ALLOWED_DOMAINS=example.test
# REGISTRATION_ENROLLMENT_KEY_B64=<base64 of independent random 32 bytes>
# Keep this master key private. zrotext-admin issue-invite derives an address-
# bound token for the x-zrotext-registration-token request header.
# REGISTRATION_MODE=open  # Explicitly allows anyone to sign up.

# Optional trusted sources for the password-reset request lane (empty by
# default). A reset request from one of these networks, or from a browser that
# completed a sign-in before (its trusted-browser cookie), spends a budget an
# email-only attacker cannot exhaust; everything else about the reset lanes is
# unchanged. Comma-separated IPv4/IPv6 CIDRs; use documentation ranges in
# examples. See docs/SELF-HOSTING.md.
# RESET_TRUSTED_CIDRS=198.51.100.0/24
# X-Forwarded-For is honored only when the immediate connection peer falls in
# one of these networks; from any other peer the header is ignored, so it
# cannot spoof a trusted address. Configure the networks your reverse proxies
# connect from, and only trust proxies that append the real client address.
# A trusted proxy is never itself the client: a request from one without a
# usable forwarded client address gets no trusted-network budget.
# TRUSTED_PROXY_CIDRS=203.0.113.0/24

# Optional HTTPS/WSS Caddy edge profile. For a public phone, use a real DNS
# name and a publicly trusted certificate; see docs/SELF-HOSTING.md.
# EDGE_DOMAIN=gateway.example.com
# EDGE_BIND=0.0.0.0
# EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443
# Optional verification mail; SMTP_HOST enables the sender. Supply all SMTP
# fields privately. Port 465 uses implicit TLS; other ports use STARTTLS.
# SMTP_HOST=smtp.example.test
# SMTP_PORT=465
# SMTP_USERNAME=<mailbox login>
# SMTP_PASSWORD=<secret-store value>
# SMTP_FROM=notices@example.test
# SMTP_FROM_NAME=ZROtext
# SMTP_REPLY_TO=help@example.test
# Startup checks the TLS SMTP connection without sending mail. Failures warn
# with a fixed category; delivery retries also warn and eventually dead-letter.
# The server also accepts SMTP_USER/SMTP_PASS and
# EMAIL_FROM/EMAIL_FROM_NAME/EMAIL_REPLY_TO. Do not set conflicting values
# under both spellings. SMTP_SECURE=true is accepted; false is rejected.
# SMTP_SECURE=true
# SMTP_USER=<legacy alias for SMTP_USERNAME>
# SMTP_PASS=<legacy alias for SMTP_PASSWORD>
# EMAIL_FROM=<legacy alias for SMTP_FROM>
# EMAIL_FROM_NAME=<legacy alias for SMTP_FROM_NAME>
# EMAIL_REPLY_TO=<legacy alias for SMTP_REPLY_TO>

# Optional webhook signing-secret encryption. Set version and 32-byte base64
# key together; generate each key with `openssl rand -base64 32`. During
# rotation, set both secondary values together. See docs/WEBHOOK-KEK-ROTATION.md.
# WEBHOOK_KEK_VERSION=1
# WEBHOOK_KEK_B64=<base64 of random 32 bytes>
# WEBHOOK_KEK_SECONDARY_VERSION=2
# WEBHOOK_KEK_SECONDARY_B64=<base64 of a different random 32 bytes>
# Delivery requires the active KEK pair; disabled by default.
# WEBHOOK_DELIVERY_ENABLED=false
# Separate candidate sealed customer sender and owner selection route.
# SEALED_WEBHOOK_DELIVERY_ENABLED=false
# WEBHOOK_DISPATCH_CONCURRENCY=2

# Optional contact display-name and note encryption. Set version and 32-byte
# base64 key together; generate each key with `openssl rand -base64 32`. During
# rotation, set both secondary values together. See docs/SELF-HOSTING.md.
# CONTACTS_KEK_VERSION=1
# CONTACTS_KEK_B64=<base64 of random 32 bytes>
# CONTACTS_KEK_SECONDARY_VERSION=2
# CONTACTS_KEK_SECONDARY_B64=<base64 of a different random 32 bytes>

# Authenticated device sockets one account may hold per process (1-32).
# DEVICE_SOCKETS_PER_ACCOUNT=8

# Optional Stripe TEST billing only. Keep all values in a private secret store.
# STRIPE_BILLING_TEST_ENABLED=false
# STRIPE_TEST_WEBHOOK_SECRET=<test endpoint signing secret>
# STRIPE_TEST_PRICE_IDS=<comma-separated test price IDs>
# STRIPE_TEST_QUOTA_PLANS=<private test plan configuration>
# STRIPE_TEST_RECONCILE_BATCH_SIZE=25
# STRIPE_TEST_RECONCILE_CONCURRENCY=2
# STRIPE_TEST_METER_FORWARD_ENABLED=false
# STRIPE_TEST_METER_SECRET_KEY=<dedicated TEST meter-event write key>
# Optional read-only TEST usage observations; does not enable charges or credits.
# STRIPE_TEST_USAGE_RECONCILE_ENABLED=false
# STRIPE_TEST_USAGE_RECONCILE_SECRET_KEY=<dedicated TEST meter and invoice read key>
# STRIPE_TEST_HOSTED_SESSIONS_ENABLED=false
# STRIPE_TEST_CHECKOUT_PRICE_ID=<allowlisted test price ID>
# STRIPE_TEST_PORTAL_CONFIGURATION_ID=<explicit TEST portal configuration ID>
# STRIPE_TEST_RECONCILE_SECRET_KEY=<test key with subscription, charge, invoice payment and invoice read access>
# Operator-only TEST review key. Supply through a protected temporary environment;
# do not place its value in this file or Compose configuration.
# STRIPE_BILLING_RECONCILIATION_KEY=<test Events/Refunds/Disputes/Charges/InvoicePayments/Invoices read key>
# STRIPE_TEST_SESSION_SECRET_KEY=<test key with customer, Checkout and Portal writes plus Portal configuration reads>
# The opt-in real-provider hosted-session smoke separately needs Customer Read.
# Existing installations may use STRIPE_TEST_SECRET_KEY as the fallback for
# either scoped key. Set both scoped keys to avoid sharing one runtime key.
# STRIPE_TEST_SECRET_KEY=<legacy test key fallback>

# Quota-only usage-limit plans, disabled by default. No prices or payment
# provider are involved; see docs/USAGE-PLANS.md. Enabling requires a catalog,
# and a catalog requires enabling, so stale configuration fails startup. Plan
# keys and limits are operator-chosen placeholders, not recommendations.
# USAGE_LIMITS_ENABLED=false
# USAGE_LIMIT_PLANS=<comma-separated plan_key:monthly_outbound_limit entries>

# Future conversation composition remains disabled. Enabling mounts the existing owner-cookie
# adapters and authenticated device negotiation; it grants no body-transfer consent or SMS grant.
# Build the TypeScript SDK and use scripts/package_conversation_browser.mjs with a separate output
# directory before selecting that package. Existing compared trust, custody and phone approval are
# still required. This configuration example does not authorize enabling a hosted installation.
# ORIGINAL_REPLY_READER_ENABLED=false
# Requires conversation/workflow tools, current MFA and migration 088.
# CONVERSATION_ENABLED=false
# SEALED_LINE_SETUP_ENABLED=false
# CONVERSATION_SDK_DIRECTORY=<explicit packaged public SDK directory>
# CONVERSATION_WSS_ORIGIN=<independently selected canonical WSS origin>
