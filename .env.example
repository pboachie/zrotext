# Local self-host example only. Replace before exposing any service.
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
DATABASE_URL=postgres://zrotext:replace-with-a-long-random-local-secret@db:5432/zrotext
SITE_ID=local-a
INSTANCE_ID=api-1
DISPATCH_ENABLED=false
DEPLOYMENT_EPOCH=1
# Controlled synthetic test mode only; account/recipient allowlists are private
# runtime configuration and must both be nonempty before this can be enabled.
SYNTHETIC_ALPHA_ENABLED=false
# Optional M0 test socket only. Set a random 32+ character value privately.
M0_TEST_TOKEN=
# Optional until owner MFA is enabled. Use an independently generated 32-byte
# base64 key; retain it across sites and backups to keep TOTP factors usable.
MFA_ENCRYPTION_KEY_B64=
# Keep enrollment off until every account-serving instance has the same key
# and all older binaries have been drained.
MFA_ENROLLMENT_ENABLED=false
# Operator recovery mode ignores the TOTP key and permits one-use recovery
# codes with the owner's password. Use only for a lost/unavailable key.
MFA_RECOVERY_ONLY=false
